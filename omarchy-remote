class BoundedThreadingHTTPServer(ThreadingHTTPServer):
    """ThreadingHTTPServer with TLS handshakes in worker threads.

    Wrapping the listening socket with SSLContext.wrap_socket() performs the
    handshake inside accept(), in the main loop. One client that connects and
    sends nothing then blocks every other client until TCP gives up. Accept
    plain sockets here and handshake in the worker, under a timeout and a hard
    cap on concurrent connections.
    """

    MAX_CONNECTIONS = 32
    HANDSHAKE_TIMEOUT = 8

    def __init__(self, server_address, handler, ssl_context):
        self.ssl_context = ssl_context
        super().__init__(server_address, handler)
        self._slots = threading.BoundedSemaphore(self.MAX_CONNECTIONS)

    def process_request(self, request, client_address):
        if not self._slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except Exception:
            self._slots.release()
            raise

    def process_request_thread(self, request, client_address):
        tls_request = None
        try:
            request.settimeout(self.HANDSHAKE_TIMEOUT)
            tls_request = self.ssl_context.wrap_socket(request, server_side=True)
            super().process_request_thread(tls_request, client_address)
        except (OSError, ssl.SSLError):
            self.shutdown_request(tls_request or request)
        finally:
            self._slots.release()


def serve(bind, port):
    ensure_runtime()
    require_platform()
    Config.bind, Config.port = bind, port
    Config.token = os.environ.get("OMARCHY_REMOTE_TOKEN") or secrets.token_urlsafe(32)
    Config.fingerprint = make_cert()

    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.load_cert_chain(CERT_FILE, KEY_FILE)
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    httpd = BoundedThreadingHTTPServer((bind, port), Handler, context)
    httpd.daemon_threads = True

    url = f"https://{bind}:{port}/"
    qr = make_qr(url, Config.fingerprint)
    with open(STATE_FILE, "w", encoding="utf-8") as handle:
        json.dump({"url": url, "fingerprint": Config.fingerprint,
                   "qr": qr, "bind": bind, "port": port,
                   "started": int(time.time())}, handle)
    with open(PID_FILE, "w", encoding="utf-8") as handle:
        handle.write(str(os.getpid()))
    os.chmod(STATE_FILE, 0o600)
    token_file = os.path.join(RUNTIME, "token")
    with open(token_file, "w", encoding="utf-8") as handle:
        handle.write(Config.token)
    os.chmod(token_file, 0o600)

    # Keep the QR file private; the phone reads it off the screen.
    if qr:
        os.chmod(qr, 0o600)

    print(f"{APP}: {url}")
    print(f"{APP}: fingerprint {Config.fingerprint}")
    if qr:
        print(f"{APP}: QR {qr}")
    sys.stdout.flush()

    # A new session must not inherit cards, replies, or clipboard text from the
    # previous one: the token and certificate have changed, so the phone is a new
    # client and old queued actions could target an unrelated notification.
    for path in (DISCONNECT_FILE, NOTIFICATIONS_FILE, NOTIFICATIONS_LIVE,
                 NOTIFY_ACTIONS_FILE, CLIPBOARD_OUT):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    Config.started = int(time.time())
    threading.Thread(target=presence_writer, daemon=True).start()

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()
        for path in (PID_FILE, STATE_FILE, os.path.join(RUNTIME, "presence.json"),
                     os.path.join(RUNTIME, "token")):
            try:
                os.unlink(path)
            except FileNotFoundError:
                pass


def shutdown_soon():
    """Give the response a moment to flush, then end the service."""
    time.sleep(0.4)
    os.kill(os.getpid(), 15)


def running_pid():
    try:
        pid = int(open(PID_FILE, encoding="utf-8").read().strip())
    except (OSError, ValueError):
        return None
    try:
        os.kill(pid, 0)
    except OSError:
        return None
    # "_serve" is the private subcommand; a shell command that merely mentions
    # the script name must not be mistaken for the daemon.
    if not pid_matches(pid, "_serve"):
        return None
    return pid


def cmd_start(args):
    if running_pid():
        print(f"{APP}: already running (pid {running_pid()})", file=sys.stderr)
        return 1
    require_platform()
    ensure_runtime()
    bind = args.bind or lan_ip()
    # Spawn a fresh process instead of forking: keep the Gio/D-Bus connection clean.
    log = open(LOG_FILE, "ab", buffering=0)
    process = subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "_serve",
         "--port", str(args.port), "--bind", bind],
        stdin=subprocess.DEVNULL, stdout=log, stderr=log,
        start_new_session=True, close_fds=True)
    log.close()
    time.sleep(1.2)
    if not running_pid():
        print(f"{APP}: failed to start, see {LOG_FILE}", file=sys.stderr)
        print(f"{APP}: process exited with {process.poll()}", file=sys.stderr)
        return 1
    print(f"{APP}: running (pid {running_pid()})")
    return 0


def cmd_stop(_args):
    pid = running_pid()
    if not pid:
        print(f"{APP}: not running")
        return 0
    os.kill(pid, 15)
    for _ in range(20):
        time.sleep(0.1)
        if not running_pid():
            break
    else:
        os.kill(pid, 9)
    for path in (PID_FILE, STATE_FILE,
                 os.path.join(RUNTIME, "presence.json"),
                 os.path.join(RUNTIME, "token"),
                 CERT_FILE, KEY_FILE, QR_FILE):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    # The bar plugin watches these; an empty list removes the cards even
    # though FileView does not report a deletion.
    for path in (NOTIFICATIONS_FILE, NOTIFICATIONS_LIVE):
        try:
            with open(path, "w", encoding="utf-8") as handle:
                handle.write("[]")
            os.chmod(path, 0o600)
        except OSError:
            pass
    clear_actions()
    try:
        os.unlink(CLIPBOARD_OUT)
    except FileNotFoundError:
        pass
    try:
        with open(POINTER_PID, encoding="utf-8") as handle:
            pointer_pid = int(handle.read().strip())
        if pid_matches(pointer_pid, "omarchy-remote-pointer"):
            os.kill(pointer_pid, 15)
    except (OSError, ValueError):
        pass
    if shutil.which("systemctl"):
        subprocess.run(["systemctl", "--user", "stop", "omarchy-remote-pointer"],
                       capture_output=True, timeout=5)
    print(f"{APP}: stopped")
    return 0


def cmd_status(_args):
    pid = running_pid()
    if not pid:
        print(f"{APP}: stopped")
        return 1
    try:
        state = json.load(open(STATE_FILE, encoding="utf-8"))
    except (OSError, ValueError):
        state = {}
    print(f"{APP}: running (pid {pid})")
    print(f"url         : {state.get('url', '-')}")
    print(f"fingerprint : {state.get('fingerprint', '-')}")
    print(f"qr          : {state.get('qr', '-')}")
    return 0


def cmd_pair(_args):
    try:
        state = json.load(open(STATE_FILE, encoding="utf-8"))
        token = open(os.path.join(RUNTIME, "token"), encoding="utf-8").read().strip()
    except (OSError, ValueError):
        print(f"{APP}: not running", file=sys.stderr)
        return 1
    url = state.get("url", "")
    fp = state.get("fingerprint", "")
    payload = f"{url}#t={token}&f={fp}"
    print(payload, flush=True)
    qr = state.get("qr")
    if qr and shutil.which("qrencode"):
        subprocess.run(["qrencode", "-t", "ANSIUTF8", payload])
    return 0


def main(argv):
    parser = argparse.ArgumentParser(prog=APP)
    sub = parser.add_subparsers(dest="cmd")
    start = sub.add_parser("start")
    start.add_argument("--port", type=int, default=DEFAULT_PORT)
    start.add_argument("--bind", default="")
    serve_parser = sub.add_parser("_serve")
    serve_parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    serve_parser.add_argument("--bind", required=True)
    sub.add_parser("stop")
    sub.add_parser("status")
    sub.add_parser("pair")
    args = parser.parse_args(argv)

    if args.cmd in (None, "start"):
        if args.cmd is None:
            args.port, args.bind = DEFAULT_PORT, ""
        return cmd_start(args)
    if args.cmd == "stop":
        return cmd_stop(args)
    if args.cmd == "_serve":
        serve(args.bind, args.port)
        return 0
    if args.cmd == "status":
        return cmd_status(args)
    if args.cmd == "pair":
        return cmd_pair(args)
    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
