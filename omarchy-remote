def ensure_runtime():
    os.makedirs(RUNTIME, exist_ok=True)
    os.chmod(RUNTIME, 0o700)


def require_platform():
    """This service targets Omarchy on Wayland only; refuse anything else."""
    problems = []
    if not os.environ.get("WAYLAND_DISPLAY"):
        problems.append("WAYLAND_DISPLAY is not set — a Wayland session is required")
    if not os.path.isdir("/usr/share/omarchy"):
        problems.append("/usr/share/omarchy not found — Omarchy is required")
    if problems:
        for problem in problems:
            print(f"{APP}: {problem}", file=sys.stderr)
        raise SystemExit(1)


def lan_ip():
    """Local IP from the default route. Sends no packets."""
    try:
        out = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"],
                             capture_output=True, text=True, timeout=3).stdout
        match = re.search(r"src\s+(\d+\.\d+\.\d+\.\d+)", out)
        if match:
            return match.group(1)
    except (OSError, subprocess.SubprocessError):
        pass

    try:
        out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"],
                             capture_output=True, text=True, timeout=3).stdout
        for line in out.splitlines():
            match = re.search(r"inet\s+(\d+\.\d+\.\d+\.\d+)", line)
            if match:
                return match.group(1)
    except (OSError, subprocess.SubprocessError):
        pass
    return "127.0.0.1"


def fingerprint(cert_path):
    out = subprocess.run(
        ["openssl", "x509", "-in", cert_path, "-noout", "-fingerprint", "-sha256"],
        capture_output=True, text=True, check=True).stdout
    value = out.split("=", 1)[1].strip()
    return value


def make_cert():
    ensure_runtime()
    for path in (CERT_FILE, KEY_FILE):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    subprocess.run(
        ["openssl", "req", "-x509", "-newkey", "ec",
         "-pkeyopt", "ec_paramgen_curve:prime256v1",
         "-keyout", KEY_FILE, "-out", CERT_FILE,
         "-days", "1", "-nodes",
         "-subj", "/CN=omarchy-remote",
         "-addext", "subjectAltName=IP:127.0.0.1"],
        check=True, capture_output=True)
    os.chmod(KEY_FILE, 0o600)
    return fingerprint(CERT_FILE)


def make_qr(url, fingerprint_value):
    if not shutil.which("qrencode"):
        return None
    payload = f"{url}#t={Config.token}&f={fingerprint_value}"
    subprocess.run(["qrencode", "-o", QR_FILE, "-s", "7", "-m", "3", payload],
                   check=True)
    return QR_FILE


