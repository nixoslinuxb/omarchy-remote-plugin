    "XF86AudioPrev": "Previous Track", "XF86MonBrightnessUp": "Brightness Up",
    "XF86MonBrightnessDown": "Brightness Down", "XF86PowerOff": "Power",
    "XF86TouchpadToggle": "Touchpad Toggle", "XF86Eject": "Eject",
    "XF86KbdBrightnessUp": "Keyboard Light Up",
    "XF86KbdBrightnessDown": "Keyboard Light Down",
    "XF86KbdLightOnOff": "Keyboard Light",
}


def key_label(key):
    if not key:
        return ""
    if key in KEY_LABELS:
        return KEY_LABELS[key]
    if key.startswith("code:"):
        return "Key " + key.split(":", 1)[1]
    return key if len(key) <= 2 and key.isupper() else key.capitalize()


def combo_label(modmask, key):
    parts = [name for bit, name in MODS if int(modmask) & bit]
    label = key_label(key)
    if label:
        parts.append(label)
    return " + ".join(parts)


def scan_shortcuts():
    """Read the bindings out of the Omarchy Lua config.

    `hyprctl binds` reports Lua binds as dispatcher `__lua`, which cannot be
    re-dispatched. Omarchy's own keybindings menu walks the config with a stubbed
    `hl`, so the same scanner is reused here to get the real expression or
    command behind every chord.
    """
    lua = shutil.which("lua")
    source = "/usr/share/omarchy/bin/omarchy-menu-keybindings"
    if not lua or not os.path.exists(source):
        return []

    cache = None
    try:
        with open(SHORTCUT_CACHE, "r", encoding="utf-8") as handle:
            cache = json.load(handle)
    except (OSError, ValueError):
        cache = None
    if cache and time.time() - cache.get("stamp", 0) < SHORTCUT_TTL:
        return cache.get("items", [])

    try:
        text = open(source, encoding="utf-8").read()
        start = text.index("<<'LUA'\n") + len("<<'LUA'\n")
        end = text.index("\nLUA\n", start)
        program = text[start:end]
    except (OSError, ValueError):
        return cache.get("items", []) if cache else []

    script = os.path.join(RUNTIME, "shortcut-scan.lua")
    try:
        with open(script, "w", encoding="utf-8") as handle:
            handle.write(program)
        result = subprocess.run([lua, "-E", script], capture_output=True,
                                text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return cache.get("items", []) if cache else []

    items = []
    for line in (result.stdout or "").splitlines():
        parts = line.split("\t")
        if len(parts) < 5:
            continue
        modmask, description, key, kind, arg = parts[0], parts[1], parts[2], parts[3], parts[4]
        if not description or not kind:
            continue
        if key.startswith("code:"):
            continue                    # duplicate physical-key aliases
        items.append({
            "keys": combo_label(modmask, key),
            "description": description,
            "kind": kind,
            "arg": arg,
        })

    # One row per chord+action, keeping source order.
    seen = set()
    unique = []
    for item in items:
        marker = (item["keys"], item["description"], item["arg"])
        if marker in seen:
            continue
        seen.add(marker)
        unique.append(item)

    try:
        ensure_runtime()
        with open(SHORTCUT_CACHE, "w", encoding="utf-8") as handle:
            json.dump({"stamp": time.time(), "items": unique}, handle)
        os.chmod(SHORTCUT_CACHE, 0o600)
    except OSError:
        pass
    return unique


def lua_string(value):
    """Quote a value as a Lua string literal."""
    out = ['"']
    for char in value:
        if char in ('"', "\\"):
            out.append("\\" + char)
        elif char == "\n":
            out.append("\\n")
        else:
            out.append(char)
    out.append('"')
    return "".join(out)


def run_shortcut(item):
    """Run one binding.

    The config is Lua, so Hyprland's classic `dispatch exec <cmd>` syntax is
    rejected; commands have to go through `hl.dsp.exec_cmd(...)`.
    """
    kind = item.get("kind")
    arg = item.get("arg") or ""
    hyprctl = shutil.which("hyprctl")
    if not hyprctl or not arg:
        return False

    if kind == "exec":
        expression = "hl.dsp.exec_cmd(" + lua_string(arg) + ")"
    else:
        expression = arg

    try:
        result = subprocess.run([hyprctl, "dispatch", expression],
                                capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return False
    output = ((result.stdout or "") + (result.stderr or "")).strip()
    if "error" in output.lower() or "ok" not in output.lower():
        return False
    return True


def launch_terminal(command):
    """Open a terminal on the computer and run the command there.

    The terminal is a real window, so anything interactive (sudo's password
    prompt, ncurses, pagers) works exactly as if the user had typed it.
    """
    if not command.strip():
        return False
    wrapper = shutil.which("omarchy-launch-floating-terminal-with-presentation")
    try:
        if wrapper:
            subprocess.Popen([wrapper, command], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             stdin=subprocess.DEVNULL)
            return True

        for terminal in ("foot", "alacritty", "kitty", "ghostty"):
            binary = shutil.which(terminal)
            if not binary:
                continue
            subprocess.Popen(
                [binary, "-e", "bash", "-lc",
                 command + '; echo; echo "[command finished]"'],
                start_new_session=True,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL)
            return True
    except (OSError, subprocess.SubprocessError):
        return False
    return False


def notifications_muted():
    return os.path.exists(MUTE_FILE)


def read_notifications():
    try:
        with open(NOTIFICATIONS_FILE, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return []


def write_notifications(items):
    with NOTIFY_LOCK:
        for target in (NOTIFICATIONS_FILE, NOTIFICATIONS_LIVE):
            tmp = target + ".tmp"
            with open(tmp, "w", encoding="utf-8") as handle:
                json.dump(items[:50], handle)
            os.chmod(tmp, 0o600)
            os.replace(tmp, target)


def push_action(action):
    with NOTIFY_LOCK:
        try:
            actions = read_actions()
        except Exception:
            actions = []
        actions.append(action)
        tmp = NOTIFY_ACTIONS_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(actions[:50], handle)
        os.chmod(tmp, 0o600)
        os.replace(tmp, NOTIFY_ACTIONS_FILE)


# The keys already announced. Messengers reuse one notification key per
# conversation and only rewrite its text, so the marker has to include the
# content — the key alone would announce the first message and swallow the rest.
def read_actions():
    try:
        with open(NOTIFY_ACTIONS_FILE, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return []


def clear_actions():
    with NOTIFY_LOCK:
        try:
            os.unlink(NOTIFY_ACTIONS_FILE)
        except FileNotFoundError:
            pass


def pop_actions():
    """Return queued actions and remove them atomically for this caller."""
    with NOTIFY_LOCK:
        actions = read_actions()
        try:
            os.unlink(NOTIFY_ACTIONS_FILE)
        except FileNotFoundError:
            pass
        return actions


def clipboard_out_state():
    """The bar writes this file when its paste icon is pressed."""
    try:
        stat = os.stat(CLIPBOARD_OUT)
        with open(CLIPBOARD_OUT, "r", encoding="utf-8", errors="replace") as handle:
            text = handle.read(1_000_000)
        return {"id": stat.st_mtime_ns, "text": text}
    except OSError:
        return {"id": 0, "text": ""}


def outbox_items():
    items = []
    try:
        names = sorted(os.listdir(OUTBOX_DIR))
    except OSError:
        return items
    for name in names:
        path = os.path.join(OUTBOX_DIR, name)
        if os.path.islink(path) or not os.path.isfile(path) or name.startswith("."):
            continue
        try:
            stat = os.stat(path)
        except OSError:
            continue
        items.append({"id": name, "name": name, "size": stat.st_size})
    return items


def outbox_path(item_id):
    name = safe_filename(item_id)
    path = os.path.join(OUTBOX_DIR, name)
    return path if os.path.isfile(path) and not os.path.islink(path) else None


def set_volume(action, value=None):
    if action == "up":
        wpctl("set-volume", "-l", "1.5", "@DEFAULT_AUDIO_SINK@", "5%+")
    elif action == "down":
        wpctl("set-volume", "@DEFAULT_AUDIO_SINK@", "5%-")
    elif action == "mute":
        wpctl("set-mute", "@DEFAULT_AUDIO_SINK@", "toggle")
    elif action == "set" and value is not None:
        try:
            percent = max(0, min(150, int(value)))
        except (TypeError, ValueError):
            return volume_state()
        wpctl("set-volume", "@DEFAULT_AUDIO_SINK@", f"{percent}%")
    return volume_state()


