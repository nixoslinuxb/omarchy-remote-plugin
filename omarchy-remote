def safe_filename(name, fallback="file"):
    name = os.path.basename(name or "").strip()
    name = "".join(ch for ch in name if ch.isprintable() and ch not in '/\\\0')
    name = name.lstrip(".")
    if not name:
        name = fallback
    if len(name) > 120:
        stem, dot, ext = name.rpartition(".")
        name = (stem[:100] + dot + ext[:16]) if dot and len(ext) <= 16 else name[:120]
    return name


def upload_target(name):
    # Everything the phone sends lands in one place: ~/Documents/omarchy-remote.
    # O_EXCL reserves the name atomically, so two uploads with the same name
    # cannot both pick the same target and overwrite each other.
    base = os.path.join(os.path.expanduser("~"), "Documents", UPLOAD_DIR_NAME)
    os.makedirs(base, exist_ok=True)
    stem, dot, ext = name.rpartition(".")
    counter = 0
    while counter < 10000:
        suffix = f"-{counter}" if counter else ""
        target = os.path.join(base, (stem + suffix + dot + ext) if dot else (name + suffix))
        try:
            fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            return target, fd
        except FileExistsError:
            counter += 1
    raise OSError("too many files with the same name")


