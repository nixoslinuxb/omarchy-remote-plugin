def wpctl(*args):
    try:
        return subprocess.run(["wpctl", *args], capture_output=True, text=True,
                              timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def volume_state():
    out = wpctl("get-volume", "@DEFAULT_AUDIO_SINK@")
    muted = "[MUTED]" in out
    match = re.search(r"Volume:\s+([0-9.]+)", out)
    volume = round(float(match.group(1)) * 100) if match else 0
    return {"volume": volume, "muted": muted}


def set_clipboard(text):
    """Put text on the Wayland clipboard. Omarchy only, so wl-copy is present."""
    if not shutil.which("wl-copy"):
        return False
    try:
        result = subprocess.run(["wl-copy", "--type", "text/plain;charset=utf-8"],
                                input=text.encode("utf-8"), timeout=5)
        return result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


