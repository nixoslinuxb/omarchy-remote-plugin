class Media:
    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    def _names(self):
        try:
            out = subprocess.run(["busctl", "--user", "list", "--no-legend"],
                                 capture_output=True, text=True, timeout=3).stdout
        except (OSError, subprocess.SubprocessError) as error:
            print(f"omarchy-remote: busctl failed: {error}", flush=True)
            return []
        names = []
        for line in out.splitlines():
            parts = line.split()
            if not parts:
                continue
            name = parts[0]
            # Firefox publishes its own name (org.mozilla.firefox.<base64>) in
            # addition to the legacy org.mpris.MediaPlayer2.firefox.<instance>.
            if name.startswith(("org.mpris.MediaPlayer2", "org.mozilla.firefox")):
                names.append(name)
        print(f"omarchy-remote: players seen: {len(names)}", flush=True)
        return names

    @staticmethod
    def _identity(name):
        # Browsers append a per-window suffix, in several shapes:
        #   Firefox / Zen: .instance_1_75
        #   Chromium forks (Helium, Chrome, Brave): .instance12345
        #   mpv: .instance-GPhWddZj
        # Group every window of one application under a single identity.
        if name.startswith(("org.mozilla.firefox", "org.mpris.MediaPlayer2.firefox")):
            return "org.mozilla.firefox"
        if name.startswith(("org.mozilla.zen", "org.mpris.MediaPlayer2.zen")):
            return "org.mozilla.zen"
        marker = name.find(".instance")
        return name[:marker] if marker > 0 else name

    def _props(self, name):
        try:
            res = self.bus.call_sync(
                name, "/org/mpris/MediaPlayer2",
                "org.freedesktop.DBus.Properties", "GetAll",
                GLib.Variant("(s)", ("org.mpris.MediaPlayer2.Player",)),
                GLib.VariantType("(a{sv})"), Gio.DBusCallFlags.NONE, 2000, None)
            return res.unpack()[0]
        except GLib.Error as error:
            print(f"omarchy-remote: props failed for {name}: {error.message}", flush=True)
            return None

    def players(self):
        found = []
        for name in self._names():
            props = self._props(name)
            if props is None:
                continue
            metadata = props.get("Metadata") or {}
            artists = metadata.get("xesam:artist") or []
            found.append({
                "id": name,
                "app": self._identity(name),
                "status": props.get("PlaybackStatus", "Stopped"),
                "title": metadata.get("xesam:title") or "",
                "artist": ", ".join(a for a in artists if a),
                "album": metadata.get("xesam:album") or "",
                "art": metadata.get("mpris:artUrl") or "",
                "length": int(metadata.get("mpris:length") or 0),
                "position": int(props.get("Position") or 0),
                "canNext": bool(props.get("CanGoNext")),
                "canPrev": bool(props.get("CanGoPrevious")),
                "canPlay": bool(props.get("CanPlay")),
                "canPause": bool(props.get("CanPause")),
                "canSeek": bool(props.get("CanSeek")),
            })
        return found

    def active(self):
        players = self.players()
        if not players:
            return None

        def score(item):
            value = 0
            if item["status"] == "Playing":
                value += 4
            elif item["status"] == "Paused":
                value += 2
            if item["art"]:
                value += 3
            if item["artist"]:
                value += 2
            if item["album"]:
                value += 1
            if item["title"]:
                value += 1
            if item["position"] > 0:
                value += 2
            if item.get("length"):
                value += 3            # real media beats a browser stub

            # Browsers (Firefox, Zen, Chromium forks like Helium) publish a
            # placeholder entry even with nothing playing. Firefox says
            # "<Browser> is playing media"; Chromium forks often repeat the
            # application name as the title.
            title = item["title"].strip().lower()
            if title.endswith("is playing media"):
                value -= 6
            app_leaf = item["app"].rsplit(".", 1)[-1].lower()
            if title and title in ("", app_leaf, item["app"].lower()):
                value -= 5

            if item["id"] == LAST_PLAYER["id"]:
                value += 1
            return value

        # One entry per application: several Chromium windows each publish a
        # player, and only the most interesting one should represent the app.
        best_per_app = {}
        for item in players:
            key = item["app"]
            current = best_per_app.get(key)
            if current is None or score(item) > score(current):
                best_per_app[key] = item

        best = max(best_per_app.values(), key=score)
        LAST_PLAYER["id"] = best["id"]
        return best

    def position_of(self, name):
        try:
            res = self.bus.call_sync(
                name, "/org/mpris/MediaPlayer2",
                "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", ("org.mpris.MediaPlayer2.Player", "Position")),
                GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 800, None)
            return int(res.unpack()[0])
        except GLib.Error:
            return 0

    def set_position(self, name, position_us):
        """Seek relative to the current position.

        MPRIS nominally allows writing Position, but several players (mpv,
        Haruna) ignore it, so a relative Seek is the portable path.
        """
        try:
            res = self.bus.call_sync(
                name, "/org/mpris/MediaPlayer2",
                "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", ("org.mpris.MediaPlayer2.Player", "Position")),
                GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 1200, None)
            current = int(res.unpack()[0])
        except GLib.Error:
            current = 0
        delta = int(position_us) - current
        if abs(delta) < 50_000:
            return True
        return self.call(name, "Seek", GLib.Variant("(x)", (delta,)))

    def call(self, name, method, args=None):
        try:
            self.bus.call_sync(
                name, "/org/mpris/MediaPlayer2",
                "org.mpris.MediaPlayer2.Player", method,
                args or GLib.Variant("()", ()),
                GLib.VariantType("()"), Gio.DBusCallFlags.NONE, 1500, None)
            return True
        except GLib.Error:
            return False


MEDIA = Media()
LAST_PLAYER = {"id": None}
# When the user picks a player on the phone it sticks until that player is gone.
SELECTED = {"id": None, "app": None}

# Per player: True once we have ever seen its position advance. A player that has
# proved it moves is trusted for the rest of the session — even if a seek briefly
# reports position 0 while it buffers, or the track loops back to the start.
SEEK_TRUSTED = {}
SEEK_SUSPECT_SINCE = {}


def player_label(item):
    """A short, human name for the player row in the phone's picker."""
    app = item["app"]
    leaf = app.rsplit(".", 1)[-1]
    if app.startswith("org.mozilla.firefox"):
        return "Firefox"
    if app.startswith("org.mozilla.zen"):
        return "Zen"
    known = {
        "firefox": "Firefox",
        "zen": "Zen",
        "chromium": "Chromium",
        "helium": "Helium",
        "chrome": "Chrome",
        "brave": "Brave",
        "vivaldi": "Vivaldi",
        "mpv": "mpv",
        "haruna": "Haruna",
        "vlc": "VLC",
        "spotify": "Spotify",
        "rhythmbox": "Rhythmbox",
    }
    return known.get(leaf.lower(), leaf.capitalize())


def all_players():
    """Every player MPRIS exposes, de-duplicated per tab/window."""
    players = MEDIA.players()
    seen = {}
    for item in players:
        # Chromium windows share an identity but have distinct titles; keep each
        # so the phone can tell two tabs apart.
        key = (item["app"], item["title"], item["status"])
        if key in seen:
            continue
        item["label"] = player_label(item)
        seen[key] = item
    return list(seen.values())


def current_player():
    """The player commands should go to: the phone's pick, else the best one."""
    players = all_players()
    if not players:
        return None
    if SELECTED["id"]:
        chosen = next((p for p in players if p["id"] == SELECTED["id"]), None)
        if chosen is not None:
            return chosen
    if SELECTED["app"]:
        chosen = next((p for p in players if p["app"] == SELECTED["app"]), None)
        if chosen is not None:
            SELECTED["id"] = chosen["id"]
            return chosen
    chosen = MEDIA.active()
    if chosen is not None:
        SELECTED["id"] = chosen["id"]
        SELECTED["app"] = chosen["app"]
    return chosen


def media_state():
    players = all_players()
    chosen = None
    if SELECTED["id"]:
        chosen = next((p for p in players if p["id"] == SELECTED["id"]), None)
    if chosen is None and SELECTED["app"]:
        # The player published a new instance name (a new tab or a new video);
        # keep driving the same application.
        chosen = next((p for p in players if p["app"] == SELECTED["app"]), None)
        if chosen is not None:
            SELECTED["id"] = chosen["id"]
    if chosen is None:
        SELECTED["id"] = None
        SELECTED["app"] = None
        chosen = MEDIA.active()
    if chosen is None:
        return {"player": None, "players": [], "selected": None}

    chosen["hasArt"] = chache_art(chosen["id"], chosen["art"])

    player_id = chosen["id"]
    position = chosen.get("position") or 0

    if position > 0:
        SEEK_TRUSTED[player_id] = True
        SEEK_SUSPECT_SINCE.pop(player_id, None)
    elif not chosen.get("length"):
        # No duration at all: live stream or a browser placeholder.
        SEEK_TRUSTED[player_id] = False

    # A player that advertises CanSeek but has never moved is a browser media
    # session stub: it reports a duration yet keeps Position at 0 forever, so a
    # seek would appear to do nothing. Only distrust it after a few seconds, and
    # only until it proves otherwise.
    if not SEEK_TRUSTED.get(player_id):
        if chosen.get("status") == "Playing" and chosen.get("length"):
            since = SEEK_SUSPECT_SINCE.setdefault(player_id, time.time())
            chosen["canSeek"] = (time.time() - since) < 5
        else:
            SEEK_SUSPECT_SINCE.pop(player_id, None)
            chosen["canSeek"] = False
    # GetAll omits Position; a live read keeps the seek bar honest.
    chosen["position"] = MEDIA.position_of(chosen["id"])
    chosen["canSeek"] = bool(chosen.get("canSeek"))
    rows = [
        {
            "id": p["id"],
            "label": p["label"],
            "title": p["title"],
            "artist": p["artist"],
            "status": p["status"],
            "selected": p["id"] == chosen["id"],
        }
        for p in players
    ]
    return {"player": chosen, "players": rows, "selected": chosen["id"]}


