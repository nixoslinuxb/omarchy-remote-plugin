ART_CACHE = {"key": None, "mime": None, "data": None}


def chache_art(player_id, art_url):
    if not art_url:
        return False
    key = f"{player_id}|{art_url}"
    if ART_CACHE["key"] == key and ART_CACHE["data"]:
        return True

    data, mime = None, None
    try:
        if art_url.startswith("data:"):
            header, _, payload = art_url.partition(",")
            if ";base64" not in header:
                return False
            import base64
            data = base64.b64decode(payload, validate=False)
            if len(data) > ART_MAX_BYTES:
                return False
            mime = header[5:].split(";")[0] or "image/jpeg"
        elif art_url.startswith("file://"):
            path = urllib.request.url2pathname(art_url[len("file://"):])
            if os.path.getsize(path) <= ART_MAX_BYTES:
                with open(path, "rb") as handle:
                    data = handle.read(ART_MAX_BYTES + 1)
                mime = "image/jpeg"
        elif art_url.startswith(("http://", "https://")):
            request = urllib.request.Request(art_url, headers={"User-Agent": APP})
            with urllib.request.urlopen(request, timeout=2) as response:
                data = response.read(ART_MAX_BYTES + 1)
                mime = response.headers.get("Content-Type", "image/jpeg")
    except (OSError, ValueError):
        return False

    if not data or len(data) > ART_MAX_BYTES:
        return False

    if data[:8] == b"\x89PNG\r\n\x1a\n":
        mime = "image/png"
    elif data[:3] == b"\xff\xd8\xff":
        mime = "image/jpeg"
    elif data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        mime = "image/webp"

    ART_CACHE.update({"key": key, "mime": mime or "image/jpeg", "data": data})
    return True


