class Config:
    token = ""
    fingerprint = ""
    bind = ""
    port = DEFAULT_PORT
    last_client = 0.0
    started = 0


def touch_client():
    Config.last_client = time.time()


def presence_writer():
    path = os.path.join(RUNTIME, "presence.json")
    while True:
        payload = {"lastClient": int(Config.last_client),
                   "running": True}
        tmp = path + ".tmp"
        try:
            with open(tmp, "w", encoding="utf-8") as handle:
                json.dump(payload, handle)
            os.chmod(tmp, 0o600)
            os.replace(tmp, path)
        except OSError:
            pass
        time.sleep(2)


def authorized(handler, _query):
    # Header only: a token in the query string would end up in the access log
    # and in shell history. Compare bytes so malformed/non-ASCII input cannot
    # raise TypeError inside the request thread.
    token = handler.headers.get("X-Token") or ""
    try:
        ok = bool(token) and secrets.compare_digest(
            token.encode("utf-8"), Config.token.encode("utf-8"))
    except (UnicodeEncodeError, TypeError):
        ok = False
    if ok:
        touch_client()
    return ok


class Handler(BaseHTTPRequestHandler):
    server_version = "omarchy-remote"
    protocol_version = "HTTP/1.1"
    # A client that opens a socket and sends nothing must not hold a thread
    # forever. This is the per-read/write socket timeout.
    timeout = 15

    def handle_one_request(self):
        try:
            super().handle_one_request()
        except (ConnectionResetError, BrokenPipeError, ssl.SSLError):
            self.close_connection = True

    def log_message(self, fmt, *args):
        # The phone polls every second; without a cap service.log grows until it
        # fills the runtime tmpfs. Keep one rotated file.
        try:
            if os.path.getsize(LOG_FILE) > LOG_MAX_BYTES:
                os.replace(LOG_FILE, LOG_FILE + ".1")
        except OSError:
            pass
        try:
            with open(LOG_FILE, "a", encoding="utf-8") as handle:
                handle.write("%s %s\n" % (time.strftime("%H:%M:%S"), fmt % args))
        except OSError:
            pass

    def _send(self, code, body, ctype="application/json", extra=None):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        elif isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        for key, value in (extra or {}).items():
            self.send_header(key, value)
        self.end_headers()
        self.wfile.write(body)

    def _query(self):
        from urllib.parse import urlparse, parse_qs
        return parse_qs(urlparse(self.path).query)

    def _json_body(self):
        """Parse the JSON body, or raise a tagged error for the caller to send."""
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            raise ValueError("bad length")
        if length > JSON_MAX_BYTES:
            raise OverflowError("body too large")
        if length <= 0:
            return {}
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except (ValueError, OSError):
            raise ValueError("bad JSON")
        return body if isinstance(body, dict) else {}

    def do_GET(self):
        from urllib.parse import urlparse
        path = urlparse(self.path).path
        query = self._query()

        if path == "/health":
            # Liveness only. The fingerprint is pairing data; an unauthenticated
            # LAN peer has no reason to learn it.
            return self._send(200, {"ok": True})
        if path == "/api/state":
            if not authorized(self, query):
                return self._send(401, {"error": "unauthorized"})
            state = {"media": media_state(), "volume": volume_state(),
                     "pair": {"fingerprint": Config.fingerprint},
                     "notificationsMuted": notifications_muted(),
                     "disconnected": os.path.exists(DISCONNECT_FILE),
                     "notifications": [] if notifications_muted() else read_notifications()}
            return self._send(200, state)
        if path == "/api/art":
            if not authorized(self, query):
                return self._send(401, {"error": "unauthorized"})
            if not ART_CACHE["data"]:
                return self._send(404, {"error": "no art"})
            return self._send(200, ART_CACHE["data"], ART_CACHE["mime"])

        if path == "/api/notify/actions":
            if not authorized(self, query):
                return self._send(401, {"error": "unauthorized"})
            # Read and clear under one lock: two overlapping polls must not both
            # execute the same reply action.
            actions = pop_actions()
            return self._send(200, {"actions": actions})

        if path == "/api/shortcuts":
            if not authorized(self, query):
                return self._send(401, {"error": "unauthorized"})
            items = scan_shortcuts()
            rows = [{"id": index, "keys": item["keys"],
                     "description": item["description"]}
                    for index, item in enumerate(items)]
            return self._send(200, {"items": rows})

        if path == "/api/clipboard/out":
            if not authorized(self, query):
                return self._send(401, {"error": "unauthorized"})
            return self._send(200, clipboard_out_state())

        if path == "/api/outbox":
            if not authorized(self, query):
                return self._send(401, {"error": "unauthorized"})
            item_id = query.get("id", [""])[0]
            if item_id:
                return self._send_outbox_file(item_id)
            return self._send(200, {"items": outbox_items()})

        return self._send(404, {"error": "not found"})

    def _send_outbox_file(self, item_id):
        path = outbox_path(item_id)
        if path is None:
            return self._send(404, {"error": "not found"})
        try:
            size = os.path.getsize(path)
        except OSError:
            return self._send(404, {"error": "not found"})
        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("Content-Length", str(size))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            with open(path, "rb") as handle:
                shutil.copyfileobj(handle, self.wfile, 65536)
        except (OSError, BrokenPipeError):
            pass

    def _upload(self, query):
        from urllib.parse import unquote

        raw_name = query.get("name", ["upload"])[0]
        name = safe_filename(unquote(raw_name))
        header = self.headers.get("Content-Length")
        if header is None:
            # Chunked bodies are not decoded here; the app always sends a length.
            return self._send(411, {"error": "length required"})
        try:
            length = int(header)
        except ValueError:
            return self._send(400, {"error": "bad length"})
        if length <= 0:
            return self._send(400, {"error": "empty body"})

        try:
            target, target_fd = upload_target(name)
        except OSError as error:
            return self._send(500, {"error": f"cannot create file: {error}"})
        written = 0
        try:
            with os.fdopen(target_fd, "wb") as handle:
                remaining = length
                while remaining > 0:
                    chunk = self.rfile.read(min(65536, remaining))
                    if not chunk:
                        break
                    handle.write(chunk)
                    written += len(chunk)
                    remaining -= len(chunk)
                if remaining > 0:
                    raise OSError("truncated upload")
        except OSError as error:
            try:
                os.unlink(target)
            except OSError:
                pass
            return self._send(500, {"error": f"write failed: {error.strerror}"})

        if written == 0:
            try:
                os.unlink(target)
            except OSError:
                pass
            return self._send(400, {"error": "empty body"})

        try:
            os.chmod(target, 0o600)
        except OSError:
            pass
        return self._send(200, {"ok": True, "path": target,
                                "bytes": written, "name": os.path.basename(target)})

    def do_POST(self):
        from urllib.parse import urlparse, unquote
        path = urlparse(self.path).path
        query = self._query()
        if not authorized(self, query):
            return self._send(401, {"error": "unauthorized"})

        # File uploads arrive as raw bytes so no multipart parser is needed.
        if path == "/api/upload":
            return self._upload(query)

        try:
            body = self._json_body()
        except OverflowError:
            return self._send(413, {"error": "body too large"})
        except ValueError:
            return self._send(400, {"error": "bad JSON"})

        if path == "/api/clipboard":
            text = body.get("text")
            if not isinstance(text, str) or not text:
                return self._send(400, {"error": "empty clipboard"})
            if len(text) > 200_000:
                return self._send(413, {"error": "clipboard too large"})
            if not set_clipboard(text):
                return self._send(500, {"error": "clipboard unavailable"})
            # Length only: the text itself stays out of the log.
            print(f"omarchy-remote: clipboard in, {len(text)} chars", flush=True)
            return self._send(200, {"ok": True, "chars": len(text)})

        if path == "/api/type":
            text = body.get("text")
            key = body.get("key")
            if key:
                if not isinstance(key, str) or len(key) > 40:
                    return self._send(400, {"error": "bad key"})
                if not type_text("", key=key):
                    return self._send(503, {"error": "keyboard unavailable"})
                return self._send(200, {"ok": True})
            if not isinstance(text, str) or not text:
                return self._send(400, {"error": "empty text"})
            if len(text) > 4000:
                return self._send(413, {"error": "text too long"})
            if not type_text(text):
                return self._send(503, {"error": "keyboard unavailable"})
            return self._send(200, {"ok": True, "chars": len(text)})

        if path == "/api/pointer":
            op = body.get("op")
            if op not in ("move", "move_by", "click", "down", "up"):
                return self._send(400, {"error": "bad op"})
            request = {"op": op}
            if op == "move":
                try:
                    request["x"] = max(0.0, min(1.0, float(body.get("x", 0.5))))
                    request["y"] = max(0.0, min(1.0, float(body.get("y", 0.5))))
                except (TypeError, ValueError):
                    return self._send(400, {"error": "bad coordinates"})
            elif op == "move_by":
                try:
                    request["dx"] = max(-4000, min(4000, int(body.get("dx", 0))))
                    request["dy"] = max(-4000, min(4000, int(body.get("dy", 0))))
                except (TypeError, ValueError):
                    return self._send(400, {"error": "bad delta"})
            else:
                request["button"] = body.get("button", "left")

            reply = pointer_command(request)
            if reply is None:
                return self._send(503, {"error": "pointer unavailable"})
            return self._send(200, reply)

        if path == "/api/terminal":
            command = body.get("command")
            if not isinstance(command, str) or not command.strip():
                return self._send(400, {"error": "empty command"})
            if len(command) > 4000:
                return self._send(413, {"error": "command too long"})
            if not launch_terminal(command):
                return self._send(503, {"error": "no terminal available"})
            return self._send(200, {"ok": True})

        if path == "/api/shortcut":
            try:
                index = int(body.get("id", -1))
            except (TypeError, ValueError):
                return self._send(400, {"error": "bad id"})
            items = scan_shortcuts()
            if index < 0 or index >= len(items):
                return self._send(404, {"error": "unknown shortcut"})
            ok = run_shortcut(items[index])
            return self._send(200 if ok else 500,
                              {"ok": ok, "description": items[index]["description"]})

        if path == "/api/player":
            player_id = body.get("id")
            if not isinstance(player_id, str) or not player_id:
                return self._send(400, {"error": "missing id"})
            SELECTED["id"] = player_id
            selected = next((p for p in all_players() if p["id"] == player_id), None)
            SELECTED["app"] = selected["app"] if selected else None
            return self._send(200, media_state())

        if path == "/api/disconnect":
            # The phone says goodbye: stop serving so the bar shows "stopped".
            ensure_runtime()
            with open(DISCONNECT_FILE, "w", encoding="utf-8") as handle:
                handle.write(str(int(time.time())))
            touch_client()
            self._send(200, {"ok": True})
            threading.Thread(target=shutdown_soon, daemon=True).start()
            return

        if path == "/api/notify/mute":
            muted = bool(body.get("muted"))
            ensure_runtime()
            if muted:
                with open(MUTE_FILE, "w", encoding="utf-8") as handle:
                    handle.write("1")
            else:
                try:
                    os.unlink(MUTE_FILE)
                except FileNotFoundError:
                    pass
            return self._send(200, {"muted": muted})

        if path == "/api/notify":
            items = body.get("items")
            if not isinstance(items, list):
                return self._send(400, {"error": "items must be a list"})
            clean = []
            for item in items[:50]:
                if not isinstance(item, dict):
                    continue
                text = str(item.get("text", ""))[:500]
                title = str(item.get("title", ""))[:120]
                app = str(item.get("app", ""))[:60]
                # Notification keys can be longer than 80 characters on apps
                # that include a tag; truncating them made reply/mark-read miss.
                key = str(item.get("key", ""))[:256]
                if not key:
                    continue
                clean.append({"key": key, "app": app, "title": title,
                              "text": text,
                              # Capabilities come from the phone's real
                              # notification actions. A calendar reminder has
                              # neither, so the bar must not offer Reply/Read.
                              "canReply": bool(item.get("canReply", False)),
                              "canRead": bool(item.get("canRead", False)),
                              "time": int(time.time())})
            write_notifications(clean)
            return self._send(200, {"ok": True, "count": len(clean)})

        if path == "/api/notify/action":
            kind = body.get("kind")
            key = body.get("key")
            if kind not in ("reply", "read") or not isinstance(key, str) or not key:
                return self._send(400, {"error": "bad action"})
            key = key[:256]
            text = str(body.get("text", ""))[:2000]
            if kind == "reply" and not text.strip():
                return self._send(400, {"error": "empty reply"})
            items = read_notifications()
            target = next((i for i in items if i.get("key") == key), None)
            # Never forward an action the notification did not advertise. This
            # rejects the stale "Reply" that used to appear on reminders.
            if target is None:
                return self._send(404, {"error": "notification gone"})
            if kind == "reply" and not target.get("canReply"):
                return self._send(400, {"error": "reply not supported"})
            if kind == "read" and not target.get("canRead"):
                return self._send(400, {"error": "read not supported"})
            action = {"kind": kind, "key": key, "text": text,
                      "time": int(time.time())}
            push_action(action)
            write_notifications([i for i in items if i.get("key") != key])
            return self._send(200, {"ok": True})

        if path == "/api/outbox/ack":
            item_id = body.get("id")
            if not isinstance(item_id, str) or not item_id:
                return self._send(400, {"error": "missing id"})
            path = outbox_path(item_id)
            if path is None:
                return self._send(404, {"error": "not found"})
            try:
                os.unlink(path)
            except OSError:
                return self._send(500, {"error": "cannot remove"})
            return self._send(200, {"ok": True})

        if path == "/api/media":
            active = current_player()
            if not active:
                return self._send(409, {"error": "no player"})
            action = body.get("action")
            name = active["id"]
            if action == "playpause":
                MEDIA.call(name, "PlayPause")
            elif action == "next":
                MEDIA.call(name, "Next")
            elif action == "previous":
                MEDIA.call(name, "Previous")
            elif action == "seekTo":
                try:
                    position_ms = max(0, int(body.get("position", 0)))
                except (TypeError, ValueError):
                    position_ms = 0
                # Never ask past the end: players either clamp oddly or wrap to 0.
                length_ms = active.get("length") or 0
                if length_ms > 0:
                    position_ms = min(position_ms, max(0, length_ms // 1000 - 500))
                MEDIA.set_position(name, position_ms * 1000)
            elif action == "seek":
                try:
                    seconds = max(-60, min(60, int(body.get("seconds", 10))))
                except (TypeError, ValueError):
                    seconds = 10
                MEDIA.call(name, "Seek", GLib.Variant("(x)", (seconds * 1_000_000,)))
            else:
                return self._send(400, {"error": "bad action"})
            return self._send(200, media_state())

        if path == "/api/volume":
            action = body.get("action")
            value = body.get("value")
            return self._send(200, set_volume(action, value))

        return self._send(404, {"error": "not found"})




