def pid_matches(pid, needle):
    """True when /proc/<pid>/cmdline belongs to the expected program.

    PID files survive crashes and the runtime tmpfs can be reused; without this
    check a recycled PID would let stop signal an unrelated process.
    """
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            cmdline = handle.read().decode("utf-8", "replace")
    except OSError:
        return False
    return needle in cmdline


def pointer_running():
    try:
        pid = int(open(POINTER_PID, encoding="utf-8").read().strip())
        os.kill(pid, 0)
        if not pid_matches(pid, "omarchy-remote-pointer"):
            return False
        return os.path.exists(POINTER_SOCKET)
    except (OSError, ValueError):
        return False


def ensure_pointer():
    """Start the virtual pointer daemon once; it lives with the service."""
    if pointer_running():
        return True
    if not os.path.exists(POINTER_BIN):
        return False
    try:
        runner = shutil.which("systemd-run")
        if runner:
            subprocess.run(
                [runner, "--user", "--collect", "--quiet",
                 "--unit=omarchy-remote-pointer",
                 "--description=omarchy-remote pointer",
                 sys.executable, POINTER_BIN],
                capture_output=True, timeout=10)
        else:
            subprocess.Popen([sys.executable, POINTER_BIN],
                             stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL,
                             start_new_session=True, close_fds=True)
    except (OSError, subprocess.SubprocessError):
        return False
    for _ in range(40):
        if os.path.exists(POINTER_SOCKET):
            return True
        time.sleep(0.1)
    return False


def pointer_command(request):
    import socket as _socket
    if not ensure_pointer():
        return None
    payload = json.dumps(request).encode("utf-8") + b"\n"
    last_error = None
    for attempt in range(8):
        try:
            with _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM) as client:
                client.settimeout(3)
                client.connect(POINTER_SOCKET)
                client.sendall(payload)
                reply = client.recv(4096).decode("utf-8", "replace").strip()
            if not reply:
                last_error = "empty reply"
                continue
            return json.loads(reply)
        except (OSError, ValueError) as error:
            last_error = error
            time.sleep(0.15 if attempt < 4 else 0.4)
    if last_error is not None:
        print(f"omarchy-remote: pointer failed: {last_error}", flush=True)
    return None


def type_text(text, key=None):
    """Type on the computer with wtype (Wayland virtual keyboard)."""
    wtype = shutil.which("wtype")
    if not wtype:
        return False
    try:
        if key:
            result = subprocess.run([wtype, "-k", key], timeout=5)
        else:
            # stdin avoids argv length limits and shell quoting entirely.
            result = subprocess.run([wtype, "-"], input=text, text=True, timeout=10)
        return result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


